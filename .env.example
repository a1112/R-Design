# Pass environment values explicitly when starting Bridge; this file is a template, not loaded automatically.
RDESIGN_PORT=4310
RDESIGN_FIXTURE_PORT=4311
# RDESIGN_WORKSPACE=/absolute/path/to/authorized/react-project
# RDESIGN_DATA_DIR=/absolute/path/to/project-data
# RDESIGN_BROWSER=/absolute/path/to/chromium
# LAN access requires TLS and a trusted exact origin.
# RDESIGN_HOST=0.0.0.0
# RDESIGN_PUBLIC_ORIGIN=https://your-mac.local:4310
# RDESIGN_TLS_CERT=/absolute/path/server.crt
# RDESIGN_TLS_KEY=/absolute/path/server.key
# Optional image provider, disabled until explicitly configured and approved in UI.
# OPENAI_API_KEY=
# RDESIGN_IMAGE_MODEL=
# RDESIGN_IMAGE_COST_CEILING_USD=0.05
# RDESIGN_ASSET_MAX_BUDGET_USD=1
# Optional independently authorized code worker.
# RDESIGN_AGENT_WORKER_URL=http://127.0.0.1:4320
# RDESIGN_AGENT_WORKER_TOKEN=
# RDESIGN_AGENT_MAX_BUDGET_USD=2

# Optional worker process (npm run worker), requires independent API key above.
# RDESIGN_AGENT_RUN_COST_CEILING_USD=1
# RDESIGN_AGENT_CANDIDATE_ROOT=/absolute/path/to/R-Design/.rdesign/candidates
# RDESIGN_AGENT_MODEL=

# Independent team service; never runs uploaded project source.
# Build the web app first. Values are templates, not automatically loaded.
# RDESIGN_TEAM_HOST=127.0.0.1
# RDESIGN_TEAM_PORT=4315
# RDESIGN_TEAM_DATA_DIR=/absolute/path/to/team-data
# RDESIGN_TEAM_PUBLIC_ORIGIN=http://127.0.0.1:4315
# RDESIGN_TEAM_BASE_PATH=
# RDESIGN_TEAM_STATIC_DIR=/absolute/path/to/dist/workbench
# Initial administrator is created only when the user database is empty.
# RDESIGN_TEAM_ADMIN_EMAIL=admin@example.com
# RDESIGN_TEAM_ADMIN_NAME=Design administrator
# RDESIGN_TEAM_ADMIN_PASSWORD=<generate-a-unique-long-password>
# For a subpath deployment, use this value when building the web app:
# RDESIGN_WEB_BASE_PATH=/r-design/
